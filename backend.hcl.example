# Remote state in S3 with locking in DynamoDB.
#
# Copy to backend.hcl next to the root module you are running (the file is git-ignored),
# then initialise with:
#
#   terraform init -backend-config=backend.hcl
#
# Credentials are NOT stored here. Use a named profile or the ambient role:
#
#   export AWS_PROFILE=platform
#
# Both the bucket and the table have to exist before the first init - the backend cannot
# create the storage it lives in. Bootstrap them once, by hand or in a separate root
# module, and never manage them from the state they hold.
#
#   aws s3api create-bucket --bucket tfstate-example-111122223333 \
#     --region eu-central-1 --create-bucket-configuration LocationConstraint=eu-central-1
#   aws s3api put-bucket-versioning --bucket tfstate-example-111122223333 \
#     --versioning-configuration Status=Enabled
#   aws s3api put-bucket-encryption --bucket tfstate-example-111122223333 \
#     --server-side-encryption-configuration \
#     '{"Rules":[{"ApplyServerSideEncryptionByDefault":{"SSEAlgorithm":"aws:kms"}}]}'
#   aws s3api put-public-access-block --bucket tfstate-example-111122223333 \
#     --public-access-block-configuration \
#     'BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true'
#   aws dynamodb create-table --table-name terraform-locks \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST --region eu-central-1

bucket = "tfstate-example-111122223333"
key    = "web-app/terraform.tfstate"
region = "eu-central-1"

# Encryption at rest for the state object. Terraform state holds every sensitive value the
# resources produced - the RDS master password is kept out of it by Secrets Manager, but the
# CloudFront key pairs, the OIDC thumbprints and every attribute a provider marks sensitive
# are in there in clear text. `sensitive` only affects what the CLI prints.
encrypt        = true
kms_key_id     = "arn:aws:kms:eu-central-1:111122223333:key/00000000-1111-2222-3333-444444444444"
dynamodb_table = "terraform-locks"

# Locking: without it two simultaneous applies overwrite each other's state and the loser
# finds out when the next plan proposes to recreate resources that already exist. The table
# needs one string partition key named LockID and nothing else.

# Optional: the state bucket usually lives in a separate account from the workloads.
# role_arn     = "arn:aws:iam::111122223333:role/terraform-state"
# session_name = "terraform"
